<odoo>
    <data noupdate="1">
        <record id="automation_get_drivers_payment" model="ir.actions.server">
            <field name="name">Get Drivers Payment</field>
            <field name="model_id" ref="gtms.model_gtms_trip"/>
            <field name="binding_model_id" ref="gtms.model_gtms_trip"/>
            <field name="state">code</field>
            <field name="code">records.get_drivers_payment()</field>
            <field name="usage">base_automation</field>
        </record>

        <record model="base.automation" id="automatic_driver_payment">
            <field name="name">Automatic Driver Payment</field>
            <field name="model_id" ref="gtms.model_gtms_trip"/>
            <field name="trigger">on_create_or_write</field>
            <field name="active" eval="True"/>
            <field name="action_server_ids"
            eval="[(4, ref('export_hours_to_pwork.automation_get_drivers_payment'))]"/>
        </record>

    </data>
</odoo>